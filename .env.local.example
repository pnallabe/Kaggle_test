# Environment Variables Template
# Copy to .env.local and customize for your environment

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
ENVIRONMENT=dev

# Server Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://api_service:password@localhost:5432/ai_analyst

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# BigQuery Configuration
BQ_ANALYTICS_DATASET=analytics
BQ_AUDIT_DATASET=audit

# Cloud Storage Configuration
GCS_ARTIFACTS_BUCKET=your-project-artifacts-xxx
GCS_BACKEND_BUCKET=your-project-backend-xxx

# Authentication Configuration
IDENTITY_PLATFORM_API_KEY=your-api-key
JWT_AUDIENCE=your-oauth-client-id
JWT_ALGORITHM=RS256

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Pub/Sub Configuration
PUBSUB_JOB_TOPIC=ai-data-analyst-jobs

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=3600

# Secret Manager
SECRET_MANAGER_PROJECT=your-gcp-project-id
